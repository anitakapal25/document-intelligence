# Upload only the runtime build context; never upload local keys or datasets.
**
!.gcloudignore
!.dockerignore
!Dockerfile
!requirements-runtime.txt
!app/
!app/**
!configs/
!configs/allowed_pdfs.json
!configs/allowed_demo_pdfs.json
!examples/
!examples/sample_agreement.pdf
app/**/__pycache__/
app/**/*.pyc
